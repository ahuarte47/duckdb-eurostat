# name: test/sql/eurostat_datadictionary.test
# description: test eurostat extension
# group: [sql]

require eurostat

query II
SELECT
    code, value
FROM
    EUROSTAT_DataDictionary('crop_pro', language := 'en')
WHERE
    code IN ('C1160', 'C1250', 'C2090', 'C2251', 'C9000')
ORDER BY
    code
;
----
C1160	Barley
C1250	Rice
C2090	Apples
C2251	Figs
C9000	Dates

